# Backend API
# Untuk dev di laptop sendiri: biarkan localhost.
# Untuk demo via HP (LAN), tetap localhost di sini — Vite proxy yang teruskan ke backend.
VITE_API_BASE_URL=http://localhost:8080

# true → frontend pakai path /api/v1 (di-proxy oleh Vite ke VITE_API_BASE_URL).
# false → frontend langsung hit VITE_API_BASE_URL (perlu CORS + URL yang reachable dari device).
VITE_USE_PROXY=true

VITE_APP_NAME=HRIS

# ── Dev server (vite) ──────────────────────────────────────────────
# Kosongkan = listen di semua interface (0.0.0.0). Bisa diakses dari HP via IP LAN.
# Isi DEV_HOST=192.168.1.7 kalau mau pin ke salah satu IP saja.
# DEV_HOST=
# DEV_PORT=5173
