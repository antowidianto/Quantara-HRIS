#====================================================================
# HRIS Frontend — STAGING Environment
#====================================================================
# Database Center: STAGING (backend di staging-api.hris.example.co.id)
#
# Aktifkan: scripts\switch-env.ps1 staging
#====================================================================

# Backend API base URL — staging server
VITE_API_BASE_URL=https://staging-api.hris.example.co.id

# Direct call (no proxy) — backend WAJIB allow CORS dari frontend staging.
VITE_USE_PROXY=false

VITE_APP_NAME=HRIS (Staging)
VITE_APP_ENV=staging