#====================================================================
# HRIS Frontend — LOCAL (Development) Environment
#====================================================================
# Database Center: LOCAL (backend di localhost:8080)
#
# Aktifkan: scripts\switch-env.ps1 local
#====================================================================

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8080

# true → frontend pakai path /api/v1 (di-proxy oleh Vite ke VITE_API_BASE_URL).
# false → frontend langsung hit VITE_API_BASE_URL (perlu CORS).
VITE_USE_PROXY=true

VITE_APP_NAME=HRIS (Local)

# Tag environment, ditampilkan di UI / console banner.
VITE_APP_ENV=local

# ── Dev server (vite) ──────────────────────────────────────────────
# Kosongkan = listen di semua interface (0.0.0.0).
# DEV_HOST=
# DEV_PORT=5173