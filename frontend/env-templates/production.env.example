#====================================================================
# HRIS Frontend — PRODUCTION Environment
#====================================================================
# Database Center: PRODUCTION (backend di api.hris.example.co.id)
#
# Aktifkan: scripts\switch-env.ps1 production
#====================================================================

# Backend API base URL — production server
VITE_API_BASE_URL=https://api.hris.example.co.id

# Direct call (no proxy). Backend HARUS allow CORS dari frontend production.
VITE_USE_PROXY=false

VITE_APP_NAME=HRIS
VITE_APP_ENV=production