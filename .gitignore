# Dependencies
node_modules/
vendor/

# Environment
.env
.env.local
.env.*.local
.env.backup

# Env templates: commit *.env.example but NEVER commit actual secret files.
# Templates live in backend/env-templates/ and frontend/env-templates/.
backend/env-templates/*.env
frontend/env-templates/*.env
!backend/env-templates/*.env.example
!frontend/env-templates/*.env.example

# Build artifacts
dist/
build/
*.log
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.suo
*.user

# CodeIgniter
backend/writable/cache/*
backend/writable/logs/*
backend/writable/session/*
backend/writable/uploads/*
backend/writable/debugbar/*
!backend/writable/.gitignore
backend/php_errors.log

# OS
.DS_Store

# Tests
phpunit.xml
.phpunit.cache/
coverage/