#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

# ─── Production Boot Guard ──────────────────────────────────────────
# Saat CI_ENVIRONMENT=production, app/Config/Boot/production.php cek bahwa
# app.baseURL, jwt.secret, dan encryption.key sudah di-set dengan benar.
# Kalau belum, server return HTTP 500 dengan pesan jelas.
#
# Escape hatch otomatis (TIDAK perlu set apa-apa):
#   1. CLI command (php spark *) — selalu lewat, dibutuhkan untuk migrate/audit
#   2. Akses dari REMOTE_ADDR localhost atau IP private RFC1918 (10.x,
#      192.168.x, 172.16-31.x) — lewat dengan response header
#      `X-HRIS-Boot-Warning`. Berguna saat pakai env=production untuk uji
#      coba lokal sebelum deploy publik.
#
# Override eksplisit (jarang dibutuhkan, mis. container build smoke check):
# production.skip_boot_guard = false

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# WAJIB DI-OVERRIDE DI PRODUCTION ke URL HTTPS publik backend.
# Dipakai untuk: PDF download absolute URL, email link, OAuth redirect.
# Production boot akan throw error kalau masih localhost — lihat
# app/Config/Boot/production.php
app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false
app.indexPage = ''
app.appTimezone = 'Asia/Jakarta'

# URL frontend Vue (production: https://hris.acme.co.id). Dipakai untuk
# build link login di email onboarding karyawan baru. Kalau kosong,
# email akan pakai `app.baseURL` sebagai fallback.
app.frontendUrl = 'http://localhost:5173'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = hris_db
database.default.username = root
database.default.password = ''
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# JWT
# Generate strong secrets via: php -r "echo bin2hex(random_bytes(64));"
#--------------------------------------------------------------------
jwt.secret = CHANGE_ME_TO_LONG_RANDOM_HEX_AT_LEAST_64_BYTES
jwt.refreshSecret = CHANGE_ME_TO_DIFFERENT_LONG_RANDOM_HEX
jwt.algo = HS256
# 15 minutes
jwt.accessTtl = 900
# 14 days
jwt.refreshTtl = 1209600
jwt.issuer = hris-api
jwt.audience = hris-app

#--------------------------------------------------------------------
# ENCRYPTION (for sensitive fields at rest)
#--------------------------------------------------------------------
encryption.key = base64:GENERATE_VIA_php_spark_key_generate
encryption.driver = OpenSSL

#--------------------------------------------------------------------
# CORS
#--------------------------------------------------------------------
cors.allowedOrigins = http://localhost:5173,http://localhost:4173

#--------------------------------------------------------------------
# RATE LIMITING
#--------------------------------------------------------------------
ratelimit.enabled = true
# 5 attempts within 15 minutes (900 seconds)
ratelimit.loginAttempts = 5
ratelimit.loginWindow = 900
ratelimit.apiPerMinute = 120

#--------------------------------------------------------------------
# MAIL (SMTP)
#--------------------------------------------------------------------
mail.host = smtp.gmail.com
mail.port = 587
mail.username = 'your-email@gmail.com'
mail.password = 'your-app-password'
mail.encryption = tls
mail.fromAddress = 'noreply@yourcompany.id'
mail.fromName = 'HRIS System'

#--------------------------------------------------------------------
# UPLOAD
#--------------------------------------------------------------------
# 5 MB
upload.maxSize = 5242880
upload.allowedMimes = 'image/jpeg,image/png,image/webp,application/pdf'

#--------------------------------------------------------------------
# COOKIE / SECURITY
#--------------------------------------------------------------------
cookie.prefix =
cookie.expires = 0
cookie.path = '/'
cookie.domain =
cookie.secure = true
cookie.httponly = true
cookie.samesite = 'Lax'
cookie.raw = false

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------
logger.threshold = 4

#--------------------------------------------------------------------
# 2FA
#--------------------------------------------------------------------
twofa.issuer = HRIS
twofa.enabled = true

#--------------------------------------------------------------------
# SPRINT A — STABILIZATION & SAFETY NET
#--------------------------------------------------------------------
# Settings yang ditambahkan oleh hardening Sprint A. Semua opsional;
# default sudah aman, override hanya kalau perlu.

# B5 — Refresh token device tracking
# Tidak ada env baru. Auto-deteksi via migration #072. Kalau tabel
# `refresh_tokens` belum punya kolom device_*, JwtService graceful skip.

# B6 — Audit log hash chain
# Tidak ada env baru. Auto-aktif setelah migration #072. Verifikasi
# manual: php spark audit:verify-chain [--chain c1-202605] [--since 2026-01-01]

# B3 — Origin guard untuk multipart upload
# Pakai cors.allowedOrigins di atas. Endpoint yang dilindungi:
#   /api/v1/auth/me/avatar
#   /api/v1/upload, /api/v1/upload/attachment
#   /api/v1/attendance/clock-in, /clock-out
# Kalau request dari Origin tidak diwhitelist → HTTP 403 INVALID_ORIGIN.

# Production boot guard — skip via private IP (dev/staging maintenance).
# Set ke "true" untuk strict mode (block walaupun dari RFC1918).
# production.skip_boot_guard = false
# production.strict_remote = false
