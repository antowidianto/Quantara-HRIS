{
    "name": "hris/backend",
    "description": "HRIS Backend API - CodeIgniter 4",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "codeigniter4/framework": "^4.5",
        "firebase/php-jwt": "^7.1",
        "phpmailer/phpmailer": "^6.9",
        "ramsey/uuid": "^4.7",
        "robthree/twofactorauth": "^2.1",
        "phpoffice/phpspreadsheet": "^5.9",
        "dompdf/dompdf": "^3.1.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.18",
        "mikey179/vfsstream": "^1.6",
        "phpstan/phpstan": "1.12",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support/"
        }
    },
    "scripts": {
        "post-update-cmd": [
            "@composer dump-autoload"
        ],
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "migration:check": "php scripts/check-migrations.php",
        "migration:fresh-sqlite": "php scripts/check-migration-runtime.php",
        "migration:fresh-mysql": "php scripts/check-migration-runtime.php --mysql",
        "permission:check": "php scripts/audit_permissions.php",
        "tenant:check": "php spark security:scan-tenant-leaks --strict --json",
        "controller-db:check": "php scripts/check-controller-db-access.php",
        "repository:sensitive-check": "php scripts/check-repository-sensitive-data.php",
        "route:matrix": "php scripts/export-route-policies.php",
        "route:check": "php scripts/export-route-policies.php --strict",
        "stan": "phpstan analyse --memory-limit=512M",
        "stan:baseline": "phpstan analyse --memory-limit=512M --generate-baseline",
        "format": "pint",
        "format:check": "pint --test",
        "ci": [
            "@migration:check",
            "@migration:fresh-sqlite",
            "@permission:check",
            "@route:check",
            "@controller-db:check",
            "@repository:sensitive-check",
            "@tenant:check",
            "@stan",
            "@test"
        ],
        "serve": "php spark serve"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "abandoned": "report"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
