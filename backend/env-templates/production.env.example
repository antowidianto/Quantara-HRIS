#====================================================================
# HRIS Backend — PRODUCTION Environment
#====================================================================
# Database Center: PRODUCTION (server live, real users, real data)
#
# Boot guard akan ENFORCE:
#   - app.baseURL bukan localhost
#   - jwt.secret tidak default
#   - encryption.key sudah di-set
# Lihat: backend/app/Config/Boot/production.php
#
# Cara pakai:
#   1. Copy file ini → backend/env-templates/production.env (gitignored)
#   2. Isi semua nilai bertanda <REPLACE_*> dengan secret real
#   3. Generate secret kuat:
#        php -r "echo bin2hex(random_bytes(64));"   (untuk JWT)
#        php spark key:generate                     (untuk encryption.key)
#   4. Aktifkan: scripts\switch-env.ps1 production
#
# JANGAN PERNAH commit production.env. Simpan secret di password manager
# atau secret store (Vault/AWS SM/GCP SM).
#====================================================================

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP — WAJIB HTTPS publik, JANGAN localhost
#--------------------------------------------------------------------
app.baseURL = 'https://api.hris.example.co.id/'
app.forceGlobalSecureRequests = true
app.indexPage = ''
app.appTimezone = 'Asia/Jakarta'
app.frontendUrl = 'https://hris.example.co.id'

#--------------------------------------------------------------------
# DATABASE — PRODUCTION (managed DB / dedicated server)
#--------------------------------------------------------------------
database.default.hostname = <REPLACE_PROD_DB_HOST>
database.default.database = hris_prod
database.default.username = <REPLACE_PROD_DB_USER>
database.default.password = '<REPLACE_PROD_DB_PASSWORD>'
database.default.DBDriver = MySQLi
database.default.DBPrefix = ''
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci
database.default.foreignKeys = true
# WAJIB false di production (jangan bocorkan SQL ke client)
database.default.DBDebug = false

#--------------------------------------------------------------------
# JWT — secret KUAT, beda dengan staging/local
#--------------------------------------------------------------------
jwt.secret = '<REPLACE_PROD_JWT_SECRET_64_BYTES_HEX>'
jwt.refreshSecret = '<REPLACE_PROD_JWT_REFRESH_SECRET_DIFFERENT>'
jwt.algo = HS256
jwt.accessTtl = 900
jwt.refreshTtl = 1209600
jwt.issuer = hris-api
jwt.audience = hris-app

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------
encryption.key = 'base64:<REPLACE_PROD_ENCRYPTION_KEY>'
encryption.driver = OpenSSL

#--------------------------------------------------------------------
# CORS — STRICT, hanya frontend production
#--------------------------------------------------------------------
cors.allowedOrigins = 'https://hris.example.co.id'

#--------------------------------------------------------------------
# RATE LIMITING
#--------------------------------------------------------------------
ratelimit.enabled = true
ratelimit.loginAttempts = 5
ratelimit.loginWindow = 900
ratelimit.apiPerMinute = 120

#--------------------------------------------------------------------
# MAIL — SMTP production (SES / SendGrid / SMTP corporate)
#--------------------------------------------------------------------
mail.host = <REPLACE_PROD_SMTP_HOST>
mail.port = 587
mail.username = '<REPLACE_PROD_SMTP_USER>'
mail.password = '<REPLACE_PROD_SMTP_PASSWORD>'
mail.encryption = tls
mail.fromAddress = 'noreply@hris.example.co.id'
mail.fromName = 'HRIS'

#--------------------------------------------------------------------
# UPLOAD
#--------------------------------------------------------------------
upload.maxSize = 5242880
upload.allowedMimes = 'image/jpeg,image/png,image/webp,application/pdf'

#--------------------------------------------------------------------
# COOKIE / SECURITY — strict
#--------------------------------------------------------------------
cookie.prefix =
cookie.expires = 0
cookie.path = '/'
cookie.domain =
cookie.secure = true
cookie.httponly = true
cookie.samesite = 'Strict'
cookie.raw = false

#--------------------------------------------------------------------
# LOGGER — error/critical only di production
#--------------------------------------------------------------------
logger.threshold = 4

#--------------------------------------------------------------------
# 2FA
#--------------------------------------------------------------------
twofa.issuer = HRIS
twofa.enabled = true