#====================================================================
# HRIS Backend — STAGING Environment
#====================================================================
# Database Center: STAGING (server staging / pre-production)
#
# Mirror production tapi dengan:
#   - Data dummy / sanitized copy dari prod
#   - Boot guard tetap nyala (uji production-like behavior)
#   - DBDebug bisa ON untuk troubleshoot
#
# Cara pakai:
#   1. Copy file ini → backend/env-templates/staging.env (gitignored)
#   2. Isi nilai-nilai bertanda <REPLACE_*>
#   3. Aktifkan: scripts\switch-env.ps1 staging
#
# JANGAN commit staging.env (berisi credential staging server).
#====================================================================

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'https://staging-api.hris.example.co.id/'
app.forceGlobalSecureRequests = true
app.indexPage = ''
app.appTimezone = 'Asia/Jakarta'
app.frontendUrl = 'https://staging.hris.example.co.id'

#--------------------------------------------------------------------
# DATABASE — STAGING (server staging MySQL/MariaDB)
#--------------------------------------------------------------------
database.default.hostname = <REPLACE_STAGING_DB_HOST>
database.default.database = hris_staging
database.default.username = <REPLACE_STAGING_DB_USER>
database.default.password = '<REPLACE_STAGING_DB_PASSWORD>'
database.default.DBDriver = MySQLi
database.default.DBPrefix = ''
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci
database.default.foreignKeys = true
# Staging boleh DBDebug=true untuk troubleshooting; matikan kalau publik.
database.default.DBDebug = true

#--------------------------------------------------------------------
# JWT — generate ulang untuk staging:
#   php -r "echo bin2hex(random_bytes(64));"
#--------------------------------------------------------------------
jwt.secret = '<REPLACE_STAGING_JWT_SECRET_64_BYTES_HEX>'
jwt.refreshSecret = '<REPLACE_STAGING_JWT_REFRESH_SECRET_DIFFERENT>'
jwt.algo = HS256
jwt.accessTtl = 900
jwt.refreshTtl = 1209600
jwt.issuer = hris-api
jwt.audience = hris-app

#--------------------------------------------------------------------
# ENCRYPTION
#   php spark key:generate
#--------------------------------------------------------------------
encryption.key = 'base64:<REPLACE_STAGING_ENCRYPTION_KEY>'
encryption.driver = OpenSSL

#--------------------------------------------------------------------
# CORS — hanya frontend staging
#--------------------------------------------------------------------
cors.allowedOrigins = 'https://staging.hris.example.co.id'

#--------------------------------------------------------------------
# RATE LIMITING
#--------------------------------------------------------------------
ratelimit.enabled = true
ratelimit.loginAttempts = 5
ratelimit.loginWindow = 900
ratelimit.apiPerMinute = 120

#--------------------------------------------------------------------
# MAIL — bisa pakai MailTrap / SES sandbox
#--------------------------------------------------------------------
mail.host = <REPLACE_STAGING_SMTP_HOST>
mail.port = 587
mail.username = '<REPLACE_STAGING_SMTP_USER>'
mail.password = '<REPLACE_STAGING_SMTP_PASSWORD>'
mail.encryption = tls
mail.fromAddress = 'noreply-staging@hris.example.co.id'
mail.fromName = 'HRIS Staging'

#--------------------------------------------------------------------
# UPLOAD
#--------------------------------------------------------------------
upload.maxSize = 5242880
upload.allowedMimes = 'image/jpeg,image/png,image/webp,application/pdf'

#--------------------------------------------------------------------
# COOKIE / SECURITY — strict (HTTPS only)
#--------------------------------------------------------------------
cookie.prefix =
cookie.expires = 0
cookie.path = '/'
cookie.domain =
cookie.secure = true
cookie.httponly = true
cookie.samesite = 'Lax'
cookie.raw = false

#--------------------------------------------------------------------
# LOGGER — info level
#--------------------------------------------------------------------
logger.threshold = 4

#--------------------------------------------------------------------
# 2FA
#--------------------------------------------------------------------
twofa.issuer = HRIS-Staging
twofa.enabled = true