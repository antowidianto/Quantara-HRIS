#====================================================================
# HRIS Backend — LOCAL (Development) Environment
#====================================================================
# Database Center: LOCAL (laptop/desktop developer, Laragon/XAMPP/Docker)
#
# Pakai file ini saat develop di laptop sendiri. DB di localhost,
# secret pakai dummy value, debug ON, CORS longgar.
#
# Aktifkan: scripts\switch-env.ps1 local   (PowerShell)
#           ./scripts/switch-env.sh local  (bash)
#====================================================================

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false
app.indexPage = ''
app.appTimezone = 'Asia/Jakarta'
app.frontendUrl = 'http://localhost:5173'

#--------------------------------------------------------------------
# DATABASE — LOCAL (Laragon MySQL / MariaDB on localhost)
#--------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = hris_db
database.default.username = root
database.default.password = ''
database.default.DBDriver = MySQLi
database.default.DBPrefix = ''
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci
database.default.foreignKeys = true
database.default.DBDebug = true

#--------------------------------------------------------------------
# JWT (dev only — JANGAN dipakai di staging/production)
#--------------------------------------------------------------------
jwt.secret = 'dev_secret_change_me_to_long_random_value_in_production_at_least_32_chars_pls'
jwt.refreshSecret = 'dev_refresh_secret_change_me_to_different_long_random_value_in_production'
jwt.algo = HS256
jwt.accessTtl = 900
jwt.refreshTtl = 1209600
jwt.issuer = hris-api
jwt.audience = hris-app

#--------------------------------------------------------------------
# ENCRYPTION (dev only)
#--------------------------------------------------------------------
encryption.key = 'base64:abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGH'
encryption.driver = OpenSSL

#--------------------------------------------------------------------
# CORS — longgar untuk dev (Vite + Vite preview)
#--------------------------------------------------------------------
cors.allowedOrigins = 'http://localhost:5173,http://localhost:4173'

#--------------------------------------------------------------------
# RATE LIMITING — santai untuk dev
#--------------------------------------------------------------------
ratelimit.enabled = true
ratelimit.loginAttempts = 20
ratelimit.loginWindow = 900
ratelimit.apiPerMinute = 600

#--------------------------------------------------------------------
# MAIL — MailHog (docker compose) atau kosong
#--------------------------------------------------------------------
mail.host = localhost
mail.port = 1025
mail.username = ''
mail.password = ''
mail.encryption = ''
mail.fromAddress = 'noreply@hris.local'
mail.fromName = 'HRIS Dev'

#--------------------------------------------------------------------
# UPLOAD
#--------------------------------------------------------------------
upload.maxSize = 5242880
upload.allowedMimes = 'image/jpeg,image/png,image/webp,application/pdf'

#--------------------------------------------------------------------
# COOKIE / SECURITY — relaxed (HTTP, bukan HTTPS)
#--------------------------------------------------------------------
cookie.prefix =
cookie.expires = 0
cookie.path = '/'
cookie.domain =
cookie.secure = false
cookie.httponly = true
cookie.samesite = 'Lax'
cookie.raw = false

#--------------------------------------------------------------------
# LOGGER — verbose untuk dev
#--------------------------------------------------------------------
logger.threshold = 9

#--------------------------------------------------------------------
# 2FA
#--------------------------------------------------------------------
twofa.issuer = HRIS
twofa.enabled = true