# HRIS Mobile — env-based configuration via react-native-config
# Copy this to `.env` (Android picks up automatically; iOS via Pods).
# Lihat docs/MOBILE_APP_PLAN.md.

# Base URL backend (jangan tutup dengan / di akhir)
API_BASE_URL=https://api.hris.example.com/api/v1

# App build identity
APP_VERSION=0.1.0
APP_BUILD=1

# Sentry / Crashlytics (boleh kosong di dev)
SENTRY_DSN=

# Default geofence radius fallback (m) saat backend tidak return work_location
DEFAULT_GEOFENCE_METERS=200